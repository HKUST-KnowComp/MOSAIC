{
  "index_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/index_omni_mm/",
  "output_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/eval_omni_mm_gemini_3_5/",
  "canonical_data_dir": "${MOSAIC_DATA_ROOT}/human_filtered_evaluation_results/dataset/stage2_human_filtered",
  "canonical_qid_manifest": "evaluation/manifests/canonical_qids.json",
  "max_personas": null,
  "query_workers": 100,
  "seed": 64,

  "embedding": {
    "model_name": "jinaai/jina-embeddings-v5-omni-small",
    "device": "cuda:0"
  },

  "retrieval": {
    "top_k": 20,
    "enable_time_filter": false,
    "query_policy": "fixed_rewrite",
    "query_manifest": "evaluation/manifests/fixed_rewrite_queries.json",
    "delivery_mode": "production_budget",
    "score_threshold": 0.0,
    "max_media_size_mb": 100,
    "max_images_per_query": 5,
    "max_audio_per_query": 5,
    "max_video_per_query": 5,
    "_note": "top_k=20 retrieves 20 chunks across ALL modalities (text, image, audio, video) from a single FAISS index. max_*_per_query only limits how many media files are base64-attached to the LLM prompt."
  },

  "reasoner": {
    "llm_model": "gemini-3.5-flash",
    "base_url": "https://yunwu.ai/v1",
    "api_key_env": "YUNWU_API_KEY",
    "timeout": {"connect": 30, "read": 300, "write": 300, "pool": 30},
    "temperature": 0.0,
    "max_tokens": 8192,
    "thinking_disabled": true,
    "api_format": "gemini",
    "_api_format_note": "Set to 'gemini' when using a Gemini model/proxy. Sends video as image_url (Gemini treats all media as inline_data) instead of the non-standard video_url type."
  },

  "logging": {
    "level": "INFO",
    "file": null
  }
}
