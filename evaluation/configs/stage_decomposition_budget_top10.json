{
  "_note": "Delivery budget sweep, point 1 of 2. Identical to stage_decomposition.json except production_top_k (10 instead of 20) and the output root. Replays the same frozen top-50 retrieval manifest with the same primary Gemini 3.5 reader, so any score difference against retrieved_raw_budgeted is attributable to the tighter delivery budget. Use with --condition retrieved_raw_budgeted only.",
  "canonical_data_dir": "${MOSAIC_DATA_ROOT}/human_filtered_evaluation_results/dataset/stage2_human_filtered",
  "canonical_qid_manifest": "evaluation/manifests/canonical_qids.json",
  "generic_text_dir": "${MOSAIC_DATA_ROOT}/clean_output/textualized/llm_filtered",
  "native_index_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/index_omni_mm",
  "production_query_manifest": "evaluation/manifests/fixed_rewrite_queries.json",
  "output_root": "${MOSAIC_DATA_ROOT}/evaluation_results/protocol_v1/budget_sweep/top10",
  "retrieval_manifest": "${MOSAIC_DATA_ROOT}/evaluation_results/protocol_v1/stage_decomposition/retrieval_manifest_top50.json",
  "production_query_manifest": "evaluation/manifests/fixed_rewrite_queries.json",
  "structured_cache": "${MOSAIC_DATA_ROOT}/evaluation_results/protocol_v1/stage_decomposition/structured_writer_cache.json",
  "retrieval_top_k": 50,
  "production_top_k": 10,
  "workers": 20,
  "embedding": {
    "model_name": "jinaai/jina-embeddings-v5-omni-small",
    "device": "cuda:0"
  },
  "production_delivery": {
    "max_images": 3,
    "max_audio": 3,
    "max_video": 3,
    "max_media_size_mb": 100,
    "supported_modalities": ["text", "image", "audio", "video"],
    "attach_media": true
  },
  "reader": {
    "llm_model": "gemini-3.5-flash",
    "base_url": "https://yunwu.ai/v1",
    "api_key_env": "YUNWU_API_KEY",
    "timeout": {
      "default": 300,
      "connect": 30,
      "read": 300,
      "write": 300,
      "pool": 30
    },
    "temperature": 0.0,
    "max_tokens": 1024,
    "max_attempts": 3,
    "retry_backoff": 2.0,
    "thinking_disabled": true,
    "api_format": "gemini"
  },
  "structured_writer": {
    "llm_model": "xiaomi/mimo-v2.5",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "timeout": {
      "default": 300,
      "connect": 30,
      "read": 300,
      "write": 300,
      "pool": 30
    },
    "temperature": 0.0,
    "max_tokens": 2048,
    "max_attempts": 3,
    "retry_backoff": 2.0,
    "extra_body": {
      "reasoning": {
        "effort": "none"
      }
    },
    "api_format": "openai"
  },
  "judge": {
    "llm_model": "qwen/qwen3.7-plus",
    "config": "evaluation/judge/config_judge.json"
  }
}
