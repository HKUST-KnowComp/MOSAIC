{
  "data_dir": "${MOSAIC_DATA_ROOT}/clean_output/textualized/llm_filtered/",
  "index_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/amem/caption_index/",
  "output_dir":"${MOSAIC_DATA_ROOT}/evaluation_results/amem/caption_output/",
  "max_personas": null,
  "build_workers": 70,
  "seed": 64,

