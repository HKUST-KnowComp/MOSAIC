{
  "index_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/index_omni_text/",
  "output_dir": "${MOSAIC_DATA_ROOT}/evaluation_results/react_omni_text/",
  "canonical_data_dir": "${MOSAIC_DATA_ROOT}/human_filtered_evaluation_results/dataset/stage2_human_filtered",
  "canonical_qid_manifest": "evaluation/manifests/canonical_qids.json",
  "react_mode": "adaptive_react",
  "execution_track": "native_end_to_end",
  "parity_baseline_config": "evaluation/rag/config_eval_omni_text_deepseekv4flash.json",
  "max_personas": null,
  "query_workers": 1000,
  "seed": 64,

  "_note": "Omni→Text ReAct: same as Caption→Text but using omni-captioned data. Text-only ReAct with function calling.",

  "embedding": {
    "model_name": "Qwen/Qwen3-Embedding-0.6B",
    "device": "cuda:0",
    "model_kwargs": {
      "attn_implementation": "flash_attention_2",
      "torch_dtype": "bfloat16"
    },
    "processor_kwargs": {
      "padding_side": "left"
    }
  },

  "react": {
    "max_iterations": 5,
    "search_top_k": 20,
    "enable_time_filter": false,
    "query_rewrite": false,
    "tool_query_rewrite": false,
    "query_policy": "fixed_rewrite",
    "query_manifest": "evaluation/manifests/fixed_rewrite_queries.json",
    "score_threshold": 0.0,
    "candidate_k": 20,
    "observation_max_results": null,
    "observation_max_chars": null,
    "reject_duplicate_queries": true,
    "_note": "Primary adaptive mode receives the original question and embeds agent tool queries unchanged. query_policy/query_manifest are used only by one_search_parity."
  },

  "react_reasoner": {
    "_comment": "LLM that searches and answers (function calling with search_memory tool).",
    "llm_model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "timeout": {"connect": 30, "read": 180, "write": 180, "pool": 30},
    "max_retries": 2,
    "retry_backoff": 2.0,
    "temperature": 0.0,
    "max_tokens": 100000,
    "thinking_disabled": true,
    "extra_body": {"thinking": {"type": "disabled"}}
  },

  "answer_reasoner": {
    "_comment": "Same as react_reasoner for text indexes (final answer comes from the ReAct agent).",
    "llm_model": "deepseek-v4-flash",
    "base_url": "https://api.deepseek.com",
    "api_key_env": "DEEPSEEK_API_KEY",
    "timeout": {"connect": 30, "read": 180, "write": 180, "pool": 30},
    "max_retries": 2,
    "retry_backoff": 2.0,
    "temperature": 0.0,
    "max_tokens": 100000,
    "thinking_disabled": true,
    "extra_body": {"thinking": {"type": "disabled"}}
  },

  "logging": {
    "level": "INFO",
    "file": null
  }
}
